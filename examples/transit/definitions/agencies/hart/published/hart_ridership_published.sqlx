config {
  type: "incremental",
  schema: "published",
  tags: ["hart", "published"],
  uniqueKey: ["service_date", "route_id", "stop_id"],
  description: "Hillsborough Area Regional Transit: validated daily ridership. Builds only after every gating check passes.",
  dependencies: [
    "assert_hart_trip_events_unique_event_id",
    "assert_hart_trip_events_no_null_keys",
    "assert_hart_ridership_daily_unique_day_route_stop",
    "assert_hart_ridership_daily_nonnegative_counts",
    "assert_hart_ridership_daily_complete_service_days",
    "assert_hart_trip_events_stop_ids_exist",
    "assert_hart_trip_events_routes_scheduled",
    "assert_hart_trip_events_service_dates_scheduled"
  ]
}

SELECT
  d.*,
  SAFE_DIVIDE(d.boardings, d.vehicle_capacity * d.trips_operated) AS load_factor,
  r.route_status,
  latest.feed_version
FROM ${ref("hart_ridership_daily")} AS d
JOIN ${ref("hart_trip_events")} USING (service_date, route_id, stop_id)
JOIN ${ref("fct_scheduled_service")} AS r USING (route_id)
CROSS JOIN (SELECT MAX(feed_version) AS feed_version FROM ${ref("stop_events")} WHERE agency_id = 'hart') AS latest
${when(incremental(), `WHERE d.service_date > (SELECT MAX(service_date) FROM ${self()})`)}

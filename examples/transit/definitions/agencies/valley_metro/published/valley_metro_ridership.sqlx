config {
  type: "view",
  schema: "published",
  tags: ["valley_metro", "published", "open_data", "public"],
  description: "Valley Metro ridership for the open-data portal, with the agency's licence attached."
}

SELECT
  p.service_date,
  p.route_id,
  p.stop_id,
  p.boardings,
  p.alightings,
  dir.display_name AS agency,
  dir.licence
FROM ${ref("valley_metro_ridership_published")} AS p
CROSS JOIN ${ref("agency_directory")} AS dir
WHERE dir.agency_id = 'valley_metro'

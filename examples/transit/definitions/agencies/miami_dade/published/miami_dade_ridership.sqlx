config {
  type: "view",
  schema: "published",
  tags: ["miami_dade", "published", "open_data", "public"],
  description: "Miami-Dade Transit ridership for the open-data portal, with the agency's licence attached."
}

SELECT
  p.service_date,
  p.route_id,
  p.stop_id,
  p.boardings,
  p.alightings,
  dir.display_name AS agency,
  dir.licence
FROM ${ref("miami_dade_ridership_published")} AS p
CROSS JOIN ${ref("agency_directory")} AS dir
WHERE dir.agency_id = 'miami_dade'

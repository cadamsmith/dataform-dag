config {
  type: "view",
  schema: "staging",
  tags: ["staging"],
  description: "Typed, deduplicated frequencies.txt rows, one per agency feed."
}

SELECT
  *
  EXCEPT (_ingested_at),
  _ingested_at AS loaded_at
FROM ${ref("frequencies")} AS src
QUALIFY ROW_NUMBER() OVER (PARTITION BY agency_id, feed_version ORDER BY _ingested_at DESC) = 1

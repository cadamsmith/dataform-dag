config {
  type: "incremental",
  schema: "core",
  tags: ["core", "mbta", "mta_nyct", "lirr", "metro_north", "njt", "path", "septa", "wmata", "mta_maryland", "bart", "sfmta", "ac_transit", "vta", "caltrain", "samtrans", "golden_gate", "trimet", "king_county_metro", "sound_transit", "community_transit", "cta", "metra", "pace", "marta", "dart", "houston_metro", "capmetro", "rtd_denver", "uta", "valley_metro", "la_metro", "octa", "mts_san_diego", "rtc_southern_nevada", "metro_transit_mn", "hart", "jta"],
  uniqueKey: ["agency_id", "service_date", "trip_id", "stop_sequence"],
  description: "Conformed scheduled service across every agency feed."
}

SELECT
  a.*,
  j0.* EXCEPT (agency_id),
  j1.* EXCEPT (agency_id)
FROM ${ref("stg_gtfs_trips")} AS a
LEFT JOIN ${ref("stg_gtfs_stop_times")} AS j0
  USING (agency_id)
LEFT JOIN ${ref("dim_routes")} AS j1
  USING (agency_id)
${when(incremental(), `WHERE a.service_date > (SELECT MAX(service_date) FROM ${self()})`)}

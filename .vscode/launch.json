{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/extension",
        // The folder the Extension Development Host opens: the in-repo example, which now compiles
        // to three assertion clusters. Swap this path to test against a project of your own.
        "${workspaceFolder}/examples/starlog"
      ],
      "outFiles": ["${workspaceFolder}/apps/extension/dist/**/*.js"]
    },
    {
      // The large example (~1,500 actions): for performance work, not for clicking through.
      "name": "Run Extension (transit, large)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/extension",
        "${workspaceFolder}/examples/transit"
      ],
      "outFiles": ["${workspaceFolder}/apps/extension/dist/**/*.js"]
    }
  ]
}

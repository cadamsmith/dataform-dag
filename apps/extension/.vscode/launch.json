{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dataform DAG Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // The folder the Extension Development Host opens; without it you land in an empty window.
        "${workspaceFolder}/../../examples/starlog"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}

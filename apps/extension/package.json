{
  "name": "dataform-dag",
  "displayName": "Dataform DAG",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive DAG viewer for a Dataform project's .sqlx dependency graph — parsed locally, no cloud.",
  "publisher": "cadamsmith",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cadamsmith/dataform-dag.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/cadamsmith/dataform-dag/issues"
  },
  "homepage": "https://github.com/cadamsmith/dataform-dag#readme",
  "keywords": [
    "dataform",
    "dag",
    "sqlx",
    "dependency graph",
    "data engineering"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "dataformDag.showGraph",
        "title": "Show Graph",
        "category": "Dataform DAG"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run build --prefix ../../packages/core && npm run build",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --packagePath extension.vsix",
    "publish:ovsx": "ovsx publish extension.vsix --no-dependencies"
  },
  "dependencies": {
    "@dataform-dag/core": "*",
    "@dataform-dag/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.0",
    "ovsx": "^0.10.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "dataform-dag",
  "displayName": "Dataform DAG",
  "version": "0.3.0",
  "private": true,
  "description": "Interactive DAG viewer for a Dataform project, compiled locally with the Dataform CLI — no cloud.",
  "publisher": "cadamsmith",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cadamsmith/dataform-dag.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/cadamsmith/dataform-dag/issues"
  },
  "homepage": "https://github.com/cadamsmith/dataform-dag#readme",
  "keywords": [
    "dataform",
    "dag",
    "sqlx",
    "dependency graph",
    "data engineering"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:dataformDag.nodes",
    "workspaceContains:workflow_settings.yaml",
    "workspaceContains:dataform.json"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The graph is built by running `dataform compile`, which evaluates the project's own JavaScript and includes."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Dataform DAG",
      "properties": {
        "dataformDag.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Dataform CLI. When empty, the project's own `node_modules/.bin/dataform` is used if present, then `dataform` on `PATH`."
        }
      }
    },
    "commands": [
      {
        "command": "dataformDag.showGraph",
        "title": "Show Graph",
        "category": "Dataform DAG",
        "icon": "$(graph)"
      },
      {
        "command": "dataformDag.showCompiledSql",
        "title": "Show Compiled SQL",
        "category": "Dataform DAG",
        "icon": "$(file-code)"
      },
      {
        "command": "dataformDag.refresh",
        "title": "Refresh",
        "category": "Dataform DAG",
        "icon": "$(refresh)"
      },
      {
        "command": "dataformDag.focusInGraph",
        "title": "Focus in Graph",
        "category": "Dataform DAG",
        "icon": "$(target)"
      },
      {
        "command": "dataformDag.groupByFolder",
        "title": "Group by Folder",
        "category": "Dataform DAG",
        "icon": "$(folder)"
      },
      {
        "command": "dataformDag.groupByType",
        "title": "Group by Type",
        "category": "Dataform DAG",
        "icon": "$(symbol-class)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataformDag",
          "title": "Dataform DAG",
          "icon": "media/dag.svg"
        }
      ]
    },
    "views": {
      "dataformDag": [
        {
          "id": "dataformDag.nodes",
          "name": "Actions",
          "contextualTitle": "Dataform DAG",
          "icon": "media/dag.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dataformDag.nodes",
        "contents": "Open a folder containing a Dataform project to list its actions.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "dataformDag.nodes",
        "contents": "The Dataform CLI was not found.\nInstall it with `npm i -g @dataform/cli`, add `@dataform/cli` to the project, or point `dataformDag.cliPath` at it.\n[Open Settings](command:workbench.action.openSettings?%5B%22dataformDag.cliPath%22%5D)\n[Refresh](command:dataformDag.refresh)",
        "when": "workbenchState != empty && dataformDag.cliMissing"
      },
      {
        "view": "dataformDag.nodes",
        "contents": "The project failed to compile.\nOpen the graph to see the error; it recompiles on save.\n[Show Graph](command:dataformDag.showGraph)\n[Refresh](command:dataformDag.refresh)",
        "when": "workbenchState != empty && dataformDag.compileFailed && !dataformDag.cliMissing"
      },
      {
        "view": "dataformDag.nodes",
        "contents": "No Dataform actions found.\nThis view lists every action `dataform compile` reports, grouped by type or by folder.\n[Refresh](command:dataformDag.refresh)",
        "when": "workbenchState != empty && !dataformDag.cliMissing && !dataformDag.compileFailed"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dataformDag.groupByFolder",
          "when": "view == dataformDag.nodes && dataformDag.treeGrouping != folder",
          "group": "navigation@0"
        },
        {
          "command": "dataformDag.groupByType",
          "when": "view == dataformDag.nodes && dataformDag.treeGrouping == folder",
          "group": "navigation@0"
        },
        {
          "command": "dataformDag.showGraph",
          "when": "view == dataformDag.nodes",
          "group": "navigation@1"
        },
        {
          "command": "dataformDag.refresh",
          "when": "view == dataformDag.nodes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dataformDag.focusInGraph",
          "when": "view == dataformDag.nodes && viewItem == dataformDagNode",
          "group": "inline@1"
        },
        {
          "command": "dataformDag.showCompiledSql",
          "when": "view == dataformDag.nodes && viewItem == dataformDagNode",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run build --prefix ../../packages/core && npm run build",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --packagePath extension.vsix",
    "publish:ovsx": "ovsx publish extension.vsix --no-dependencies"
  },
  "dependencies": {
    "@dataform-dag/core": "*",
    "@dataform-dag/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "ovsx": "^0.10.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
